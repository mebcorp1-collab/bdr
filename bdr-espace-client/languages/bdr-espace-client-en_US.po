msgstr "Password"

msgid "Rester connecté"
msgstr "Stay logged in"

msgid "Se connecter"
msgstr "Log in"

msgid "Mot de passe oublié ?"
msgstr "Forgot your password?"

msgid "Pas encore d'accès ? Demandez-le à votre agence."
msgstr "No access yet? Ask your branch."

msgid "Bonjour %s"
msgstr "Hello %s"

msgid "Se déconnecter"
msgstr "Log out"

msgid "Mes dossiers"
msgstr "My cases"

msgid "Vous n'avez aucun dossier pour le moment. Votre conseiller en ouvrira un si nécessaire."
msgstr "You don't have any cases yet. Your advisor will open one if needed."

msgid "Dernière activité"
msgstr "Last activity"

