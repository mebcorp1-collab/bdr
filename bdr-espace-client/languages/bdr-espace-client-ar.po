msgstr "لا توجد رسائل حاليًا."

msgid "Votre message"
msgstr "رسالتك"

msgid "Ne communiquez jamais vos mots de passe ou codes de carte, même à votre conseiller."
msgstr "لا تُفصح أبدًا عن كلمات المرور أو الرموز السرية لبطاقتك، حتى لمستشارك."

msgid "Envoyer"
msgstr "إرسال"

msgid "Fichier"
msgstr "الملف"

msgid "Déposé par"
msgstr "أودعه"

