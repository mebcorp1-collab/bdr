msgstr "لا توجد وثائق حاليًا."

msgid "Déposer un document"
msgstr "إيداع وثيقة"

msgid "Formats acceptés : PDF, JPG, PNG. Taille maximale : %s."
msgstr "الصيغ المقبولة: PDF وJPG وPNG. الحجم الأقصى: %s."

msgid "Déposer"
msgstr "إيداع"

msgid "Client BDR"
msgstr "زبون BDR"

msgid "Conseiller BDR"
msgstr "مستشار BDR"

msgid "Aucun fichier reçu."
msgstr "لم يتم استلام أي ملف."

msgid "Le fichier n'a pas pu être reçu. Veuillez réessayer."
msgstr "تعذّر استلام الملف. يرجى إعادة المحاولة."

msgid "Type de fichier non autorisé."
msgstr "نوع الملف غير مسموح به."

msgid "Le contenu du fichier ne correspond pas à son type."
msgstr "محتوى الملف لا يتوافق مع نوعه."

msgid "Le stockage des documents n'est pas disponible. Contactez la banque."
msgstr "تخزين الوثائق غير متاح. يرجى الاتصال بالبنك."

