#. Plugin Name of the plugin
#: bdr-net.php
msgid "BDR-NET"
msgstr "BDR-NET"

#. Description of the plugin
#: bdr-net.php
msgid "Espace client BDR-NET : suivi des dossiers, dépôt de documents et messagerie sécurisée entre le client et son conseiller. Aucune opération bancaire."
msgstr "BDR-NET client space: case tracking, document upload and secure messaging between clients and their advisor. No banking transactions."

#: bdr-net.php:26
msgid "BDR-NET : désactivez puis supprimez l'ancienne extension « BDR Espace Client ». BDR-NET la remplace et reprend ses dossiers, messages et documents."
msgstr "BDR-NET: deactivate and delete the former “BDR Espace Client” plugin. BDR-NET replaces it and keeps its cases, messages and documents."

